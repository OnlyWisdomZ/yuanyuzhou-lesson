<view class="login-by-phone-board">
    <van-field custom-class="field"
               label="手机号码"
               right-icon="user-o"
               clearable="{{true}}"
               model:value="{{ phone }}"
               placeholder="请输入手机号码"
               border="{{ false }}"/>
    <van-field custom-class="field"
               center
               clearable="{{true}}"
               label="短信验证码"
               placeholder="请输入短信验证码"
               border="{{ false }}"
               use-button-slot
               model:value="{{ vcode }}">
        <van-button slot="button"
                    size="small"
                    type="primary"
                    bind:tap="getVcode">
            发送验证码
        </van-button>
    </van-field>
    <van-button custom-class="login-btn"
                type="info"
                block
                bind:tap="loginByPhone">
        登录
    </van-button>
    <van-row custom-class="link">
        <van-col span="12" bind:tap="toRegister">注册新账号</van-col>
        <van-col span="12" bind:tap="toLoginByAccount">账号密码登录</van-col>
    </van-row>
</view>