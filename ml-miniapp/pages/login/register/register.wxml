<view class="register-board">
    <van-field custom-class="field"
               label="登录账号"
               right-icon="user-o"
               clearable="{{true}}"
               model:value="{{ username }}"
               placeholder="请输入登录账号"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="登录密码"
               right-icon="eye-o"
               type="password"
               clearable="{{true}}"
               model:value="{{ password }}"
               placeholder="请输入登录密码"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="确认密码"
               right-icon="eye-o"
               type="password"
               clearable="{{true}}"
               model:value="{{ rePassword }}"
               placeholder="请确认登录密码"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="真实姓名"
               right-icon="contact-o"
               clearable="{{true}}"
               model:value="{{ realname }}"
               placeholder="请输入真实姓名"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="手机号码"
               right-icon="phone-o"
               clearable="{{true}}"
               model:value="{{ phone }}"
               placeholder="请输入手机号码"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="身份证号"
               right-icon="user-circle-o"
               clearable="{{true}}"
               model:value="{{ idcard }}"
               placeholder="请输入身份证号"
               border="{{ false }}"/>
    <van-field custom-class="field"
               label="电子邮箱"
               right-icon="envelop-o"
               clearable="{{true}}"
               model:value="{{ email }}"
               placeholder="请输入电子邮箱"
               border="{{ false }}"/>
    <van-button custom-class="register-btn"
                type="info"
                block
                bind:tap="register">
        注册
    </van-button>
    <van-row custom-class="link">
        <van-col span="12" bind:tap="toLoginByAccount">账号密码登录</van-col>
        <van-col span="12" bind:tap="toLoginByPhone">手机号码登录</van-col>
    </van-row>
</view>